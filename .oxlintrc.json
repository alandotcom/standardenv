{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "oxc"],
  "env": {
    "node": true
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "nursery": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "import/extensions": "off"
  },
  "overrides": [
    {
      "files": ["*.test.ts", "*.spec.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    }
  ]
}
